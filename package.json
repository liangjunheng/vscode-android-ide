{
  "name": "vscode-android-ide",
  "displayName": "VSCode Android IDE",
  "description": "A VS Code Android IDE for managing devices, emulators, Logcat, and debugging without leaving your editor.",
  "version": "1.0.0",
  "publisher": "liangjunheng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liangjunheng/vscode-android-ide.git"
  },
  "bugs": {
    "url": "https://github.com/liangjunheng/vscode-android-ide/issues"
  },
  "homepage": "https://github.com/liangjunheng/vscode-android-ide#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1f22",
    "theme": "dark"
  },
  "keywords": [
    "android",
    "emulator",
    "avd",
    "adb",
    "logcat",
    "scrcpy",
    "device manager",
    "mirroring",
    "flutter",
    "kotlin"
  ],
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs adb, emulator and avdmanager from the Android SDK."
    },
    "virtualWorkspaces": false
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p . --noEmit",
    "vscode:prepublish": "npm run typecheck && node esbuild.js --production && node scripts/verify-runtime.mjs",
    "package": "vsce package",
    "test": "node --test tests/*.test.js",
    "clean": "rm -rf dist *.vsix"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "androidTools",
          "title": "Device Tools",
          "icon": "media/icons/device-manager.svg"
        }
      ],
      "panel": [
        {
          "id": "androidLogcat",
          "title": "Logcat",
          "icon": "media/icons/logcat.svg"
        }
      ]
    },
    "views": {
      "androidTools": [
        {
          "type": "webview",
          "id": "android-ide.runningDevice",
          "name": "Device Tools"
        }
      ],
      "androidLogcat": [
        {
          "type": "webview",
          "id": "android-ide.logcat",
          "name": "Logcat"
        }
      ]
    },
    "commands": [
      {
        "command": "android-ide.refresh",
        "title": "Device Tools: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "android-ide.createAvd",
        "title": "Device Tools: Create Virtual Device",
        "icon": "$(add)"
      },
      {
        "command": "android-ide.startAvd",
        "title": "Device Tools: Start Emulator",
        "icon": "$(play)"
      },
      {
        "command": "android-ide.coldBootAvd",
        "title": "Device Tools: Cold Boot Emulator"
      },
      {
        "command": "android-ide.stopAvd",
        "title": "Device Tools: Stop Emulator",
        "icon": "$(debug-stop)"
      },
      {
        "command": "android-ide.editAvd",
        "title": "Device Tools: Edit Virtual Device",
        "icon": "$(edit)"
      },
      {
        "command": "android-ide.wipeAvd",
        "title": "Device Tools: Wipe Data"
      },
      {
        "command": "android-ide.deleteAvd",
        "title": "Device Tools: Delete Virtual Device",
        "icon": "$(trash)"
      },
      {
        "command": "android-ide.mirrorDevice",
        "title": "Device Tools: Show in Running Devices",
        "icon": "$(device-mobile)"
      },
      {
        "command": "android-ide.pairDevice",
        "title": "Device Tools: Connect Device over Wi-Fi (adb connect)",
        "icon": {
          "light": "media/icons/pair-over-wifi-light.svg",
          "dark": "media/icons/pair-over-wifi-dark.svg"
        }
      },
      {
        "command": "android-ide.showLogcat",
        "title": "Device Tools: Show Logcat"
      },
      {
        "command": "android-ide.extendedControls",
        "title": "Device Tools: Extended Controls"
      },
      {
        "command": "android-ide.addDevice",
        "title": "Device Tools: Select Device",
        "icon": "$(device-mobile)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "android-ide.createAvd",
          "when": "view == android-ide.runningDevice",
          "group": "navigation@1"
        },
        {
          "command": "android-ide.pairDevice",
          "when": "view == android-ide.runningDevice",
          "group": "navigation@2"
        },
        {
          "command": "android-ide.refresh",
          "when": "view == android-ide.runningDevice",
          "group": "navigation@3"
        }
      ]
    },
    "debuggers": [
      {
        "type": "android-tools",
        "label": "Android Tools JVM Debugger",
        "languages": [
          "java",
          "kotlin"
        ],
        "initialConfigurations": []
      }
    ],
    "configuration": {
      "title": "VSCode Android IDE",
      "properties": {
        "android-ide.embeddedEmulator": {
          "type": "boolean",
          "default": true,
          "description": "Start emulators without their own window and display them in the Running Devices view (gRPC)."
        },
        "android-ide.mirrorVisible": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Show device mirroring in Device Tools. The mirror toggle saves this setting and restores it after extension restart."
        },
        "android-ide.deviceViewMode": {
          "type": "string",
          "scope": "window",
          "enum": [
            "mirror",
            "explorer",
            "processes",
            "hidden"
          ],
          "default": "mirror",
          "description": "Active Device Tools surface. Mirroring, Device Explorer files, and Processes are mutually exclusive; hidden closes all three. Explicit values take precedence over android-ide.mirrorVisible."
        },
        "android-ide.explorer.packageFilter": {
          "type": "boolean",
          "scope": "window",
          "default": false,
          "description": "Filter Device Explorer app entries and processes by application IDs in the current project."
        },
        "android-ide.mirrorIntervalMs": {
          "type": "number",
          "default": 150,
          "description": "Minimum delay between screen captures in the screenshot fallback mode (physical devices without scrcpy support)."
        },
        "android-ide.logcat.maxBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 65536,
          "maximum": 67108864,
          "description": "Maximum UTF-8 bytes of Logcat content kept in memory (default matches Android Studio)."
        },
        "android-ide.fixSoftwareRendering": {
          "type": "boolean",
          "default": true,
          "description": "Before launching an AVD that has hw.gpu.enabled=no (the avdmanager default, very slow), switch it to host GPU rendering by editing its config.ini."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": [
          "/.vscode/android-ide.local.json"
        ],
        "url": "./schemas/android-ide.local.schema.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.7",
    "@grpc/proto-loader": "^0.8.1",
    "@vscode/debugadapter": "1.68.0",
    "@xmldom/xmldom": "0.9.12",
    "long": "5.3.2",
    "unzipper": "0.12.5",
    "xpath": "0.0.36"
  },
  "author": {
    "name": "liangjunheng"
  }
}
