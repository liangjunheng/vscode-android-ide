    "configuration": {
      "title": "VSCode Android IDE",
      "properties": {
        "android-ide.jvmDebugger.javaHome": { "type": "string", "default": "", "description": "Full JDK 17+ for the bundled JVM debugger; defaults to JAVA_HOME and PATH." },
        "android-ide.jvmDebugger.adapterJvmArgs": { "type": "array", "items": { "type": "string" }, "default": ["-Xmx512m"] },
        "android-ide.jvmDebugger.traceProtocol": { "type": "boolean", "default": false, "description": "Trace JVM DAP messages in the Android Kotlin/Java Debugger output channel." },
        "android-ide.jvmDebugger.logLevel": { "type": "string", "enum": ["ERROR", "WARN", "INFO", "DEBUG", "TRACE"], "default": "INFO" },
        "android-ide.embeddedEmulator": {
          "type": "boolean",
          "default": true,
          "description": "Start emulators without their own window and display them in the Running Devices view (gRPC)."
        },
        "android-ide.mirrorVisible": {
          "type": "boolean",
          "scope": "window",
          "default": true,
          "description": "Show device mirroring in Device Tools. The mirror toggle saves this setting and restores it after extension restart."
        },
        "android-ide.nativeMirror": {
          "type": "boolean",
          "default": false,
          "description": "Run physical-device mirroring in an independent native scrcpy window instead of the VS Code Webview. Keep false to embed mirroring in Device Tools."
        },
        "android-ide.deviceViewMode": {
          "type": "string",
          "scope": "window",
          "enum": [
            "mirror",
            "explorer",
            "processes",
            "hidden"
          ],
          "default": "mirror",
          "description": "Active Device Tools surface. Mirroring, Device Explorer files, and Processes are mutually exclusive; hidden closes all three. Explicit values take precedence over android-ide.mirrorVisible."
        },
        "android-ide.explorer.packageFilter": {
          "type": "boolean",
          "scope": "window",
          "default": false,
          "description": "Filter Device Explorer app entries and processes by application IDs in the current project."
        },
        "android-ide.mirrorIntervalMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Minimum delay between screen captures in the screenshot fallback mode; 0 captures the next frame immediately after the previous capture completes."
        },
        "android-ide.logcat.maxBytes": {
          "type": "number",
          "default": 1048576,
          "minimum": 65536,
          "maximum": 67108864,
          "description": "Maximum UTF-8 bytes of Logcat content kept in memory (default matches Android Studio)."
        },
        "android-ide.fixSoftwareRendering": {
          "type": "boolean",
          "default": true,
          "description": "Before launching an AVD that has hw.gpu.enabled=no (the avdmanager default, very slow), switch it to host GPU rendering by editing its config.ini."
        }
      }
    },
