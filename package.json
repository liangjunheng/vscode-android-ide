{
  "name": "vscode-android-ide",
  "displayName": "VSCode Android IDE",
  "description": "A VS Code Android IDE for managing devices, emulators, Logcat, and debugging without leaving your editor.",
  "version": "1.0.4",
  "publisher": "liangjunheng",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liangjunheng/vscode-android-ide.git"
  },
  "bugs": {
    "url": "https://github.com/liangjunheng/vscode-android-ide/issues"
  },
  "homepage": "https://github.com/liangjunheng/vscode-android-ide#readme",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1f22",
    "theme": "dark"
  },
  "keywords": [
    "android",
    "emulator",
    "avd",
    "adb",
    "logcat",
    "scrcpy",
    "device manager",
    "mirroring",
    "flutter",
    "kotlin"
  ],
  "engines": {
    "vscode": "^1.95.0",
    "node": ">=22"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Runs adb, emulator and avdmanager from the Android SDK."
    },
    "virtualWorkspaces": false
  },
  "extensionDependencies": [
    "redhat.java",
    "vscjava.vscode-java-debug",
    "vscjava.vscode-gradle",
    "vadimcn.vscode-lldb"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/gradlew",
    "workspaceContains:**/gradlew.bat",
    "workspaceContains:build.gradle",
    "workspaceContains:**/build.gradle",
    "workspaceContains:settings.gradle",
    "workspaceContains:**/settings.gradle",
    "workspaceContains:build.gradle.kts",
    "workspaceContains:**/build.gradle.kts",
    "workspaceContains:settings.gradle.kts",
    "workspaceContains:**/settings.gradle.kts",
    "onDebugResolve:android-tools",
    "onDebugDynamicConfigurations:android-tools",
    "onDebugResolve:android-debug",
    "onDebugDynamicConfigurations:android-debug",
    "onDebugResolve:lldb",
    "onDebugResolve:android-jvm",
    "onDebugDynamicConfigurations:android-jvm"
  ],
  "scripts": {
    "compile": "npm run build:jvm && node esbuild.js",
    "build:jvm": "node scripts/build-jvm-debugger.cjs",
    "test:jvm": "node scripts/build-jvm-debugger.cjs --test",
    "watch": "npm run build:jvm && node esbuild.js --watch",
    "typecheck": "tsc -p . --noEmit",
    "vscode:prepublish": "npm run typecheck && npm run build:jvm && node esbuild.js --production && node scripts/verify-core-runtime.cjs",
    "package": "vsce package",
    "test": "node --test tests/*.test.js",
    "clean": "rm -rf dist *.vsix"
  },
  "contributes": {
    "languages": [{ "id": "kotlin", "aliases": ["Kotlin", "kotlin"], "extensions": [".kt", ".kts"] }],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "androidTools",
          "title": "Device Tools",
          "icon": "media/icons/device-manager.svg",
          "when": "android-ide.hasAndroidProject"
        }
      ],
      "panel": [
        {
          "id": "androidLogcat",
          "title": "Logcat",
          "icon": "media/icons/logcat.svg",
          "when": "android-ide.hasAndroidProject"
        }
      ]
    },
    "views": {
      "androidTools": [
        {
          "type": "webview",
          "id": "android-ide.runningDevice",
          "name": "Device Tools",
          "when": "android-ide.hasAndroidProject"
        }
      ],
      "androidLogcat": [
        {
          "type": "webview",
          "id": "android-ide.logcat",
          "name": "Logcat",
          "when": "android-ide.hasAndroidProject"
        }
      ]
    },
    "commands": [
      {
        "command": "android-ide.refresh",
        "title": "Device Tools: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "android-ide.createAvd",
        "title": "Device Tools: Create Virtual Device",
        "icon": "$(add)"
      },
      {
        "command": "android-ide.startAvd",
        "title": "Device Tools: Start Emulator",
        "icon": "$(play)"
      },
      {
        "command": "android-ide.coldBootAvd",
        "title": "Device Tools: Cold Boot Emulator"
      },
      {
        "command": "android-ide.stopAvd",
        "title": "Device Tools: Stop Emulator",
        "icon": "$(debug-stop)"
      },
      {
        "command": "android-ide.editAvd",
        "title": "Device Tools: Edit Virtual Device",
        "icon": "$(edit)"
      },
      {
        "command": "android-ide.wipeAvd",
        "title": "Device Tools: Wipe Data"
      },
      {
        "command": "android-ide.deleteAvd",
        "title": "Device Tools: Delete Virtual Device",
        "icon": "$(trash)"
      },
      {
        "command": "android-ide.mirrorDevice",
        "title": "Device Tools: Show in Running Devices",
        "icon": "$(device-mobile)"
      },
      {
        "command": "android-ide.pairDevice",
        "title": "Device Tools: Connect Device over Wi-Fi (adb connect)",
        "icon": {
          "light": "media/icons/pair-over-wifi-light.svg",
          "dark": "media/icons/pair-over-wifi-dark.svg"
        }
      },
      {
        "command": "android-ide.showLogcat",
        "title": "Device Tools: Show Logcat"
      },
      {
        "command": "android-ide.extendedControls",
        "title": "Device Tools: Extended Controls"
      },
      {
        "command": "android-ide.addDevice",
        "title": "Device Tools: Select Device",
        "icon": "$(device-mobile)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "android-ide.showLogcat",
          "when": "android-ide.hasAndroidProject"
        }
      ],
      "view/title": [
        {
          "command": "android-ide.createAvd",
          "when": "view == android-ide.runningDevice",
          "group": "navigation@1"
        },
        {
          "command": "android-ide.pairDevice",
          "when": "view == android-ide.runningDevice",
          "group": "navigation@2"
        },
        {
          "command": "android-ide.refresh",
          "when": "view == android-ide.runningDevice",
          "group": "navigation@3"
        }
      ]
    },
    "debuggers": [
      {
        "type": "android-jvm",
        "label": "Kotlin/Java (JVM)",
        "languages": ["kotlin", "java"],
        "configurationAttributes": {
          "attach": {
            "properties": {
              "android": { "const": true },
              "serial": { "type": "string" },
              "target": { "type": "string", "default": "select" },
              "pid": { "type": ["integer", "string"] },
              "processId": { "type": ["integer", "string"] },
              "packageName": { "type": "string" },
              "androidProjectRoot": { "type": "string" },
              "androidModuleRoot": { "type": "string" },
              "androidVariant": { "type": "string" },
              "androidSourceRoots": { "type": "array", "items": { "type": "string" } },
              "hostName": { "type": "string", "default": "127.0.0.1" },
              "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "preLaunchTask": { "type": "string" },
              "adapterJvmArgs": { "type": "array", "items": { "type": "string" } },
              "projectRoot": { "type": "string", "default": "${workspaceFolder}" },
              "sourcePaths": { "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "const": "auto" }] },
              "stepFilters": { "type": "array", "items": { "type": "string" } },
              "suspendAllThreads": { "type": "boolean", "default": false },
              "showToString": { "type": "boolean", "default": true },
              "asyncStackTraces": { "type": "boolean", "default": true },
              "coroutineStepping": { "type": "boolean", "default": true },
              "invocationTimeout": { "type": "number", "default": 5000 },
              "logLevel": { "enum": ["ERROR", "WARN", "INFO", "DEBUG", "TRACE"] }
            }
          }
        },
        "configurationSnippets": []
      },
      {
        "type": "android-debug",
        "label": "Android Debug",
        "languages": ["kotlin", "java", "c", "cpp"],
        "variables": {
          "pickAndroidProcess": "android-tools.pickAndroidProcess",
          "abi": "android-tools.getBestAbi",
          "mappedAbi": "android-tools.getBestMappedAbi"
        },
        "configurationAttributes": {
          "attach": {
            "properties": {
              "mode": { "enum": ["native", "java", "dual"] },
              "serial": { "type": "string", "description": "Android device serial; omit to select a device." },
              "target": { "type": "string", "default": "select", "description": "Android serial, select, or last-selected." },
              "pid": { "type": ["integer", "string"], "description": "Optional process id." },
              "processId": { "type": ["integer", "string"], "description": "Optional process id or android-tools.pickAndroidProcess result." },
              "packageName": { "type": "string" },
              "projectRoot": { "type": "string", "default": "${workspaceFolder}" },
              "sourcePaths": { "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "const": "auto" }] },
              "resumeProcess": { "type": "boolean", "description": "Resume the waiting process after attach." },
              "native": {
                "type": "object",
                "description": "Configuration passed to the Native debugger.",
                "properties": {
                  "sdkRoot": { "type": "string" },
                  "ndkRoot": { "type": "string" },
                  "abiSupported": { "type": "array", "items": { "enum": ["armeabi", "armeabi-v7a", "arm64-v8a", "x86", "x86_64"] } },
                  "abi": { "enum": ["auto", "select", "armeabi", "armeabi-v7a", "arm64-v8a", "x86", "x86_64"] },
                  "abiMap": { "type": "object", "additionalProperties": { "type": "string" } },
                  "symbolSearchPaths": { "type": "array", "items": { "type": "string" }, "description": "Directories containing unstripped .so files." }
                }
              },
              "java": {
                "type": "object",
                "description": "Configuration passed to the Kotlin/JVM debugger.",
                "properties": {
                  "type": { "const": "android-jvm" },
                  "name": { "type": "string" },
                  "projectRoot": { "type": "string", "default": "${workspaceFolder}" },
                  "sourcePaths": { "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "const": "auto" }] },
                  "hostName": { "type": "string", "default": "127.0.0.1" },
                  "port": { "type": "integer", "minimum": 0, "maximum": 65535 }, "preLaunchTask": { "type": "string" }, "adapterJvmArgs": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          },
          "launch": {
            "properties": {
              "mode": { "enum": ["native", "java", "dual"] },
              "serial": { "type": "string", "description": "Android device serial; omit to select a device." },
              "target": { "type": "string", "default": "select", "description": "Android serial, select, or last-selected." },
              "pid": { "type": ["integer", "string"], "description": "Optional process id." },
              "processId": { "type": ["integer", "string"], "description": "Optional process id." },
              "apkPath": { "type": "string", "description": "Optional APK to install for this launch." },
              "packageName": { "type": "string" },
              "launchActivity": { "type": "string" },
              "projectRoot": { "type": "string", "default": "${workspaceFolder}" },
              "sourcePaths": { "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "const": "auto" }] },
              "resumeProcess": { "type": "boolean", "description": "Resume the waiting process after launch." },
              "native": {
                "type": "object",
                "description": "Configuration passed to the Native debugger.",
                "properties": {
                  "sdkRoot": { "type": "string" },
                  "ndkRoot": { "type": "string" },
                  "abiSupported": { "type": "array", "items": { "enum": ["armeabi", "armeabi-v7a", "arm64-v8a", "x86", "x86_64"] } },
                  "abi": { "enum": ["auto", "select", "armeabi", "armeabi-v7a", "arm64-v8a", "x86", "x86_64"] },
                  "abiMap": { "type": "object", "additionalProperties": { "type": "string" } },
                  "symbolSearchPaths": { "type": "array", "items": { "type": "string" }, "description": "Directories containing unstripped .so files." }
                }
              },
              "java": {
                "type": "object",
                "description": "Configuration passed to the Kotlin/JVM debugger.",
                "properties": {
                  "type": { "const": "android-jvm" },
                  "name": { "type": "string" },
                  "projectRoot": { "type": "string", "default": "${workspaceFolder}" },
                  "sourcePaths": { "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "const": "auto" }] },
                  "hostName": { "type": "string", "default": "127.0.0.1" },
                  "port": { "type": "integer", "minimum": 0, "maximum": 65535 }, "preLaunchTask": { "type": "string" }, "adapterJvmArgs": { "type": "array", "items": { "type": "string" } },
                  "mainClass": { "type": "string" },
                  "classPaths": { "type": "array", "items": { "type": "string" } },
                  "modulePaths": { "type": "array", "items": { "type": "string" } },
                  "vmArgs": { "type": ["string", "array"], "items": { "type": "string" } },
                  "args": { "type": ["string", "array"], "items": { "type": "string" } },
                  "cwd": { "type": "string", "default": "${workspaceFolder}" },
                  "env": { "type": "object" }
                }
              }
            }
          }
        },
        "initialConfigurations": [
          { "type": "android-debug", "request": "launch", "name": "Android: Native Debug Launch", "mode": "native", "target": "auto", "apkPath": "auto", "packageName": "auto", "launchActivity": "auto", "native": { "abi": "auto", "symbolSearchPaths": [] } },
          { "type": "android-debug", "request": "attach", "name": "Android: Native Debug Attach", "mode": "native", "target": "auto", "pid": "auto", "native": {} },
          { "type": "android-debug", "request": "launch", "name": "Android: JVM Debug Launch", "mode": "java", "target": "auto", "apkPath": "auto", "packageName": "auto", "launchActivity": "auto", "java": { "type": "android-jvm", "name": "Android JVM", "sourcePaths": "auto", "adapterJvmArgs": [] } },
          { "type": "android-debug", "request": "attach", "name": "Android: JVM Debug Attach", "mode": "java", "target": "auto", "pid": "auto", "java": { "type": "android-jvm", "name": "Android JVM", "adapterJvmArgs": [] } },
          { "type": "android-debug", "request": "launch", "name": "Android: Dual(Native and JVM) Debug Launch", "mode": "dual", "target": "auto", "apkPath": "auto", "packageName": "auto", "launchActivity": "auto", "native": { "abi": "auto", "symbolSearchPaths": [] }, "java": { "type": "android-jvm", "name": "Android JVM", "sourcePaths": "auto", "adapterJvmArgs": [] } },
          { "type": "android-debug", "request": "attach", "name": "Android: Dual(Native and JVM) Debug Attach", "mode": "dual", "target": "auto", "pid": "auto", "native": {}, "java": { "type": "android-jvm", "name": "Android JVM", "adapterJvmArgs": [] } }
        ],
        "configurationSnippets": [
          { "label": "Android: Native Debug Launch", "body": { "type": "android-debug", "request": "launch", "name": "Native Debug Launch", "mode": "native", "target": "select", "apkPath": "^\"\\${workspaceFolder}/${1:app}/build/outputs/apk/debug/app-debug.apk\"", "packageName": "${2:com.example.app}", "launchActivity": "${3:com.example.app.MainActivity}", "native": { "abi": "${4|select,armeabi,armeabi-v7a,arm64-v8a,x86,x86_64|}", "symbolSearchPaths": ["^\"\\${workspaceFolder}/${5:app}/build/intermediates/merged_native_libs/debug/mergeDebugNativeLibs/out/lib/\\${command:abi}/\""] } } },
          { "label": "Android: Native Debug Attach", "body": { "type": "android-debug", "request": "attach", "name": "Native Debug Attach", "mode": "native", "target": "select", "processId": "^\"\\${command:android-tools.pickAndroidProcess}\"", "packageName": "${1:com.example.app}", "native": { "abi": "${2|select,armeabi,armeabi-v7a,arm64-v8a,x86,x86_64|}", "symbolSearchPaths": ["^\"\\${workspaceFolder}/${3:app}/build/intermediates/merged_native_libs/debug/mergeDebugNativeLibs/out/lib/\\${command:abi}/\""] } } },
          { "label": "Android: JVM Debug Launch", "body": { "type": "android-debug", "request": "launch", "name": "JVM Debug Launch", "mode": "java", "target": "select", "apkPath": "^\"\\${workspaceFolder}/${1:app}/build/outputs/apk/debug/app-debug.apk\"", "packageName": "${2:com.example.app}", "launchActivity": "${3:com.example.app.MainActivity}", "java": { "type": "android-jvm", "name": "Android JVM", "sourcePaths": ["^\"\\${workspaceFolder}/${4:app}/src/main/java\""], "adapterJvmArgs": [] } } },
          { "label": "Android: JVM Debug Attach", "body": { "type": "android-debug", "request": "attach", "name": "JVM Debug Attach", "mode": "java", "target": "select", "processId": "^\"\\${command:android-tools.pickAndroidProcess}\"", "packageName": "${1:com.example.app}", "java": { "type": "android-jvm", "name": "Android JVM", "sourcePaths": ["^\"\\${workspaceFolder}/${2:app}/src/main/java\""], "adapterJvmArgs": [] } } },
          { "label": "Android: Dual(Native and JVM) Debug Launch", "body": { "type": "android-debug", "request": "launch", "name": "Dual Debug Launch", "mode": "dual", "target": "select", "apkPath": "^\"\\${workspaceFolder}/${1:app}/build/outputs/apk/debug/app-debug.apk\"", "packageName": "${2:com.example.app}", "launchActivity": "${3:com.example.app.MainActivity}", "native": { "abi": "${4|select,armeabi,armeabi-v7a,arm64-v8a,x86,x86_64|}", "symbolSearchPaths": ["^\"\\${workspaceFolder}/${5:app}/build/intermediates/merged_native_libs/debug/mergeDebugNativeLibs/out/lib/\\${command:abi}/\""] }, "java": { "type": "android-jvm", "name": "Android JVM", "sourcePaths": ["^\"\\${workspaceFolder}/${6:app}/src/main/java\""], "adapterJvmArgs": [] } } },
          { "label": "Android: Dual(Native and JVM) Debug Attach", "body": { "type": "android-debug", "request": "attach", "name": "Dual Debug Attach", "mode": "dual", "target": "select", "processId": "^\"\\${command:android-tools.pickAndroidProcess}\"", "packageName": "${1:com.example.app}", "native": { "abi": "${2|select,armeabi,armeabi-v7a,arm64-v8a,x86,x86_64|}", "symbolSearchPaths": ["^\"\\${workspaceFolder}/${3:app}/build/intermediates/merged_native_libs/debug/mergeDebugNativeLibs/out/lib/\\${command:abi}/\""] }, "java": { "type": "android-jvm", "name": "Android JVM", "sourcePaths": ["^\"\\${workspaceFolder}/${4:app}/src/main/java\""], "adapterJvmArgs": [] } } }
        ]
